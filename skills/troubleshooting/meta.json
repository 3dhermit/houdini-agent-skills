{
  "name": "troubleshooting",
  "version": "1.0.0",
  "description": "Diagnose red nodes, unknown node types/parms and wrong hou API names - against the running build, with a verified error knowledge base.",
  "houdini_versions": ["19.5", "20.0", "20.5", "21.0", "22.0"],
  "verified_on": ["22.0.368"],
  "dependencies": ["houdini_skills"],
  "triggers": ["this node is red", "why is my geo empty", "invalid node type", "hou has no attribute", "cook failed"],
  "examples": [
    "hython -m houdini_skills.cli troubleshooting diagnose_node --json '{\"path\":\"/obj/asm_sop/bevel1\"}'",
    "python -m houdini_skills.cli troubleshooting hou_lookup --json '{\"name\":\"version\"}'"
  ],
  "sources": [
    {"repo": "https://github.com/healkeiser/fxhoudinimcp", "license": "MIT", "used_for": "parity with get_node_errors_detailed; independent implementation"}
  ],
  "actions": {
    "diagnose_node": {
      "type": "object",
      "required": ["path"],
      "properties": {"path": {"type": "string"}}
    },
    "hou_lookup": {
      "type": "object",
      "required": ["name"],
      "properties": {"name": {"type": "string", "minLength": 2}}
    },
    "explain_error": {
      "type": "object",
      "required": ["message"],
      "properties": {"message": {"type": "string", "minLength": 3}}
    },
    "node_type_lookup": {
      "type": "object",
      "required": ["name"],
      "properties": {"name": {"type": "string"}, "network": {"type": "string", "default": "/obj"}}
    },
    "empty_geo_report": {
      "type": "object",
      "required": ["path"],
      "properties": {"path": {"type": "string"}}
    },
    "version_report": {"type": "object", "properties": {}}
  }
}
